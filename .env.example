# Password for the control web interface (required in production)
ADMIN_PASSWORD=change-me
# Optional: secret used to sign login cookies (defaults to a hash of the password)
AUTH_SECRET=
# Postgres connection string (set automatically by the Vercel Neon integration).
# Leave empty for local development: an embedded database in .data/ is used.
DATABASE_URL=
# Vercel Blob token (set automatically when a Blob store is connected).
# Leave empty for local development: files are stored in .data/blobs.
BLOB_READ_WRITE_TOKEN=
# Upload storage cap in MB
MAX_STORAGE_MB=900
